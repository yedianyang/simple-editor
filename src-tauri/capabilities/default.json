{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FieldCorder DAW default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "/**" }]
    },
    "shell:default",
    "core:window:allow-start-dragging"
  ]
}
